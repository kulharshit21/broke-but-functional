    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  }
